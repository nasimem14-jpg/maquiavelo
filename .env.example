# Obligatoria: la clave que escribirás en la app (Conectores > Backend).
# Sin ella, el backend rechaza todas las peticiones.
MAQ_ACCESS_KEY=pon-aqui-una-clave-larga-y-aleatoria

# Notion: secreto de una integración interna (notion.so/profile/integrations).
# Comparte con esa integración las páginas que quieras que Maquiavelo pueda leer.
NOTION_TOKEN=

# Búsqueda web (Tavily, tavily.com): clave de API.
TAVILY_API_KEY=

# Wikipedia: idioma (opcional, por defecto "es").
WIKI_LANG=es
